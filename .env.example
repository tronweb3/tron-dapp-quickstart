# Copy this file to `.env` (committed defaults) or `.env.local` (git-ignored, for secrets).
# All vars are exposed to the client via Vite's `TDQ_` prefix (see vite.config.ts).

# --- Required ---
# TronGrid / full node endpoint used to build, broadcast and read on-chain state.
#   Mainnet: https://api.trongrid.io
#   Nile testnet:   https://nile.trongrid.io
#   Shasta testnet: https://api.shasta.trongrid.io
TDQ_FULL_HOST="https://nile.trongrid.io"

# --- Optional ---
# Human-readable network label shown in the header badge.
TDQ_CURRENT_CHAIN="Nile Testnet"

# Tronscan base URL for explorer deep links (transaction / address / contract).
#   Mainnet: https://tronscan.org
#   Nile:    https://nile.tronscan.org
#   Shasta:  https://shasta.tronscan.org
TDQ_EXPLORER_BASE="https://nile.tronscan.org"

# TronGrid API key — strongly recommended. Public endpoints are heavily rate-limited
# (~1 QPS) and will return 403/429 under load. Get a free key at https://www.trongrid.io
# Keep real keys in .env.local so they are never committed.
# TDQ_API_KEY=""
